[Unit]
Description=dnscacher caching DNS forwarder
Documentation=file:/usr/local/share/doc/dnscacher/README.md
After=network.target
Before=nss-lookup.target
Wants=nss-lookup.target
StartLimitIntervalSec=30s
StartLimitBurst=5

[Service]
Type=simple
ExecStartPre=/usr/local/bin/dnscacher --check --config /etc/dnscacher.toml
ExecStart=/usr/local/bin/dnscacher --config /etc/dnscacher.toml
Restart=on-failure
RestartSec=2s
TimeoutStopSec=20s

# Run as an unprivileged dynamic account.  StateDirectory gives the service a
# stable, writable /var/lib/dnscacher for the cache snapshots, and
# RuntimeDirectory provides /run/dnscacher for the cache control socket.
DynamicUser=yes
StateDirectory=dnscacher
StateDirectoryMode=0750
RuntimeDirectory=dnscacher
RuntimeDirectoryMode=0750

# Keep only the capability needed to bind port 53.
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
NoNewPrivileges=yes

# Filesystem and kernel hardening.
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM
RemoveIPC=yes
UMask=0077

[Install]
WantedBy=multi-user.target
