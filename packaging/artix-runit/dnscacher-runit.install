post_install() {
    cat <<'EOF'
dnscacher-runit is installed but dnscacher is not enabled.

  sudo ln -s /etc/runit/sv/dnscacher /run/runit/service/
  sudo sv start dnscacher

Then check it with:

  dog example.com @127.0.0.1
  tail -F /var/log/dnscacher/current
EOF
}

post_upgrade() {
    cat <<'EOF'
dnscacher-runit was updated.  Restart the service to use the new files:

  sudo sv restart dnscacher
EOF
}

pre_remove() {
    if command -v sv >/dev/null 2>&1; then
        sv stop dnscacher >/dev/null 2>&1 || true
    fi
    rm -f /run/runit/service/dnscacher
}
