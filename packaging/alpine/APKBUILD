# Maintainer: ez-me <66479626+ez-me@users.noreply.github.com>
pkgname=dnscacher
pkgver=0.3.0
pkgrel=0
pkgdesc="Caching DNS forwarder with UDP, TCP, DoT and DoH support"
url="https://github.com/vibecoded-ezme/dnscacher"
arch="x86_64 aarch64 ppc64le s390x"
license="MIT"
pkgusers="dnscacher"
pkggroups="dnscacher"
makedepends="cargo"
subpackages="$pkgname-openrc"
options="net"
source="$pkgname-$pkgver.tar.gz::https://github.com/vibecoded-ezme/dnscacher/archive/refs/tags/v$pkgver.tar.gz
	$pkgname.initd
	$pkgname.confd
	build-apk.sh
	"
builddir="$srcdir/$pkgname-$pkgver"

prepare() {
	default_prepare
	cargo fetch --locked
}

build() {
	cargo build --release --locked --frozen
}

check() {
	cargo test --release --locked --frozen
}

package() {
	install -Dm755 target/release/dnscacher \
		"$pkgdir"/usr/bin/dnscacher
	install -Dm644 deploy/dnscacher.toml \
		"$pkgdir"/etc/dnscacher.toml
	install -Dm644 README.md \
		"$pkgdir"/usr/share/doc/$pkgname/README.md
	install -Dm644 LICENSE \
		"$pkgdir"/usr/share/licenses/$pkgname/LICENSE
	install -Dm755 "$srcdir"/$pkgname.initd \
		"$pkgdir"/etc/init.d/$pkgname
	install -Dm644 "$srcdir"/$pkgname.confd \
		"$pkgdir"/etc/conf.d/$pkgname
}

# Run 'abuild checksum' after the v$pkgver tag is published, or after placing
# the source tarball in $SRCDEST, to fill in the tarball checksum below.
sha512sums="
